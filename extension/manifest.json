{
  "manifest_version": 3,
  "name": "Invisibles: hidden character cleaner",
  "version": "1.2.1",
  "description": "Find and strip hidden characters locally. Uses only Chrome's side-panel UI permission and has no host access.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Invisibles: clean hidden characters",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
